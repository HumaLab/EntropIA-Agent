# Copia este archivo a ".env" dentro de esta carpeta y completa los valores.
# Nunca commitees ".env" (el .gitignore lo excluye).

# Clave de API de OpenRouter. Sin ella, el agente no arranca.
OPENROUTER_API_KEY=

# Modelo de OpenRouter. Vacío usa openai/gpt-5.6-luna-pro.
OPENROUTER_MODEL=

# Path a la base SQLite común de la app EntropIA. Sin ella, el agente corre sin fuentes.
ENTROPIA_DB_PATH=
